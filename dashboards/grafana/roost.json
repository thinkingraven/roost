{
  "__inputs": [],
  "title": "roost: how your AI agents are used",
  "uid": "roost-agents",
  "description": "Daily, counts-only summaries from `roost export` (Claude Code, Codex, Gemini CLI) and rookery's policy hook. https://github.com/thinkingraven/roost",
  "tags": [
    "roost",
    "ai-agents"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "team",
        "label": "Team (regex)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0
      },
      {
        "name": "agent",
        "label": "Agent",
        "type": "custom",
        "query": "claude-code,codex,gemini-cli",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Adoption",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Active people",
      "description": "Distinct hashed people with at least one session.",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "count(sum by (roost_person) (count_over_time({service_name=\"roost\"} | event_name=\"roost.activity\" | roost_team=~\"$team\" | roost_agent=~\"$agent\" [$__range])))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Sessions",
      "description": "Agent sessions, counted once per day they were active.",
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "sum (sum_over_time({service_name=\"roost\"} | event_name=\"roost.activity\" | roost_team=~\"$team\" | roost_agent=~\"$agent\" | unwrap roost_sessions [$__range]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
