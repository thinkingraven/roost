    {
      "type": "timeseries",
      "title": "Active people per day, by agent",
      "description": "",
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "count by (roost_agent) (sum by (roost_agent, roost_person) (count_over_time({service_name=\"roost\"} | event_name=\"roost.activity\" | roost_team=~\"$team\" | roost_agent=~\"$agent\" [1d])))",
          "legendFormat": "{{roost_agent}}",
          "step": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {}
    },
